POSTGRES_DB=grocery
POSTGRES_USER=grocery
POSTGRES_PASSWORD=change-me

# Authentik (SSO)
AUTHENTIK_DB=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=change-me
# generate with: openssl rand -base64 60 | tr -d "\n"
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_TAG=2025.10.0
# Client secret of the OIDC provider used by grocery-sso-service
AUTHENTIK_OIDC_CLIENT_SECRET=change-me

# grocery-sso-service: where to send the user after login (leave empty until the frontend exists)
FRONTEND_URL=

# grocery-categorizer: free key from https://fdc.nal.usda.gov/api-key-signup.html
# (optional: without it only the local keyword rules are used)
USDA_API_KEY=

# grocery-telegram-adapter: token of the bot, from @BotFather
# (optional: without it the stack starts, but sharing on Telegram answers 503)
TELEGRAM_BOT_TOKEN=
